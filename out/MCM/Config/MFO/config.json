{
  "modName": "MFO",
  "displayName": "marth Follower Overhaul",
  "minMcmVersion": 9,
  "cursorFillMode": "topToBottom",
  "pages": [
    {
      "pageDisplayName": "Gameplay",
      "cursorFillMode": "topToBottom",
      "content": [
        {
          "text": "Rapport",
          "type": "header"
        },
        {
          "id": "fRapportRate:General",
          "text": "Rapport rate",
          "type": "slider",
          "help": "Multiplier on all rapport earned.",
          "valueOptions": {
            "min": 0.0,
            "max": 5.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat",
            "defaultValue": 1.0
          }
        },
        {
          "id": "fRapportKill:General",
          "text": "Rapport per kill",
          "type": "slider",
          "valueOptions": {
            "min": 0.0,
            "max": 10.0,
            "step": 0.5,
            "sourceType": "ModSettingFloat",
            "defaultValue": 1.0
          }
        },
        {
          "id": "fRapportBossMult:General",
          "text": "Boss multiplier",
          "type": "slider",
          "help": "Rapport multiplier for killing a foe this many levels above you.",
          "valueOptions": {
            "min": 1.0,
            "max": 20.0,
            "step": 0.5,
            "sourceType": "ModSettingFloat",
            "defaultValue": 5.0
          }
        },
        {
          "id": "fRapportDragonMult:General",
          "text": "Dragon multiplier",
          "type": "slider",
          "valueOptions": {
            "min": 1.0,
            "max": 30.0,
            "step": 0.5,
            "sourceType": "ModSettingFloat",
            "defaultValue": 10.0
          }
        },
        {
          "id": "iBossLevelDelta:General",
          "text": "Boss level delta",
          "type": "slider",
          "help": "A foe at least this many levels above you counts as a boss.",
          "valueOptions": {
            "min": 1,
            "max": 30,
            "step": 1,
            "sourceType": "ModSettingInt",
            "defaultValue": 5
          }
        },
        {
          "id": "fSharedRadius:General",
          "text": "Shared-kill radius",
          "type": "slider",
          "help": "A follower within this range shares the kill credit.",
          "valueOptions": {
            "min": 500.0,
            "max": 8000.0,
            "step": 100.0,
            "sourceType": "ModSettingFloat",
            "defaultValue": 3000.0
          }
        },
        {
          "id": "bAllowSummons:General",
          "text": "Count summon kills",
          "type": "toggle",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 0
          }
        },
        {
          "id": "bRapportToasts:General",
          "text": "Rank-up notifications",
          "type": "toggle",
          "help": "ON (default): one HUD line when a follower's rapport rank rises (\"Lydia fights beside you with new resolve.\"). Rank changes are rare, so this cannot spam. OFF: rank changes go to the log only.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 1
          }
        }
      ]
    },
    {
      "pageDisplayName": "Combat & Casting",
      "cursorFillMode": "topToBottom",
      "content": [
        {
          "text": "Gambits",
          "type": "header"
        },
        {
          "id": "bEquipToCast:General",
          "text": "Equip spells to cast",
          "type": "toggle",
          "help": "Put a gambit spell in the follower's hand so their own AI casts it.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 1
          }
        },
        {
          "id": "bCasterHook:General",
          "text": "Influence casting (mobile)",
          "type": "toggle",
          "help": "Let a follower cast a gambit spell while still moving and fighting. Installs a hook; needs a game restart.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 1
          }
        },
        {
          "id": "bForceCastOnMiss:General",
          "text": "Force the chosen spell",
          "type": "toggle",
          "help": "ON (default): if a follower's own AI casts a different spell (or nothing) during the grace window, the gambit's configured spell is force-cast at the chosen target -- with line of sight required. OFF: the old behaviour (the AI decides, silent fallback).",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 1
          }
        },
        {
          "id": "bCommandTarget:General",
          "text": "Commanded targeting",
          "type": "toggle",
          "help": "Let attack gambits pick which foe a follower fights. Needs a game restart.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 1
          }
        },
        {
          "text": "Timing",
          "type": "header"
        },
        {
          "id": "fCastCooldown:General",
          "text": "Cast cooldown (s)",
          "type": "slider",
          "help": "Minimum seconds between a follower's gambit casts.",
          "valueOptions": {
            "min": 0.0,
            "max": 30.0,
            "step": 0.5,
            "sourceType": "ModSettingFloat",
            "defaultValue": 4.0
          }
        },
        {
          "id": "fAiCastGrace:General",
          "text": "AI cast grace (s)",
          "type": "slider",
          "help": "How long to wait for the follower's own AI to cast before MFO does it silently.",
          "valueOptions": {
            "min": 0.0,
            "max": 15.0,
            "step": 0.5,
            "sourceType": "ModSettingFloat",
            "defaultValue": 3.0
          }
        },
        {
          "id": "fMagickaReserve:General",
          "text": "Magicka reserve",
          "type": "slider",
          "help": "Fraction of magicka a gambit will not spend below. 0 = spend freely.",
          "valueOptions": {
            "min": 0.0,
            "max": 0.9,
            "step": 0.05,
            "sourceType": "ModSettingFloat",
            "defaultValue": 0.0
          }
        }
      ]
    },
    {
      "pageDisplayName": "Logistics",
      "cursorFillMode": "topToBottom",
      "content": [
        {
          "text": "Non-combat behaviour",
          "type": "header"
        },
        {
          "id": "bLogistics:General",
          "text": "Enable logistics",
          "type": "toggle",
          "help": "Let followers drink potions and loot arrows/potions/gear out of combat.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 1
          }
        },
        {
          "id": "bLootInPlayerHomes:General",
          "text": "Loot in player homes",
          "type": "toggle",
          "help": "OFF (default): followers never loot in your own house (any cell flagged LocTypePlayerHouse). ON: they loot there too. Drinking/supply is unaffected either way.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 0
          }
        },
        {
          "id": "iMinPotionMag:General",
          "text": "Ignore weak potions (min power)",
          "type": "slider",
          "help": "A restore potion below this magnitude is ignored entirely; the rest are looted strongest-first. 0 = AUTO: use your load order's weakest restore tier (logged as [potfloor] at startup, e.g. drops 'Minor' but keeps standard+). A positive value is an explicit floor across health/stamina/magicka. Fortify/cure potions are never filtered.",
          "valueOptions": {
            "min": 0,
            "max": 500,
            "step": 5,
            "sourceType": "ModSettingInt",
            "defaultValue": 0
          }
        },
        {
          "id": "bEconomy:General",
          "text": "Follower economy (sell/buy)",
          "type": "toggle",
          "help": "OFF (default): a follower at a merchant only LOGS what it would trade (dry run). ON: it sells its unworn junk (highest-value first, capped by the vendor's gold) and buys supplies it is short on. Stand a follower by a merchant to trade.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 0
          }
        },
        {
          "id": "bAutoRetreat:General",
          "text": "Auto-retreat when outmatched",
          "type": "toggle",
          "help": "ON (default): a follower who is badly outmatched (low confidence -- foe count, level and health feed it) AND far from you in combat falls back to your side, the confidence leash taken to its conclusion. Fires once per fight; the follower stops gambitting while falling back. OFF: they fight on wherever the gambit table sends them (author your own fall-back rule instead). Anniversary Edition only (like walk-to-loot); does nothing on Special Edition 1.5.97.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 1
          }
        },
        {
          "id": "bMagicLoadout:General",
          "text": "Magic loadout (school gear + backup)",
          "type": "toggle",
          "help": "ON (default): a follower with cast gambits (a magic user) loots enchanted apparel matching his most-cast magic school -- a Destruction robe for a destruction mage -- in preference to raw armor rating on those slots (school match first, then fanciness: gold value + fortify strength), plus one melee backup weapon for when his magicka runs out. OFF: everyone loots by armor rating only.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 1
          }
        },
        {
          "id": "bMageDaggersOnly:General",
          "text": "Mage backup: daggers only",
          "type": "toggle",
          "help": "ON (default): the magic user's melee backup is a dagger -- a caster's sidearm. OFF: he takes the best of any one-handed weapon instead.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 1
          }
        },
        {
          "id": "fLootRadius:General",
          "text": "Loot scan (units)",
          "type": "slider",
          "help": "How far a follower scans for loot (~70 units = 1m; a cell = 4096; 3000 ~= 4-5 rooms). Candidates must also be within the confidence leash of you.",
          "valueOptions": {
            "min": 200.0,
            "max": 4096.0,
            "step": 50.0,
            "sourceType": "ModSettingFloat",
            "defaultValue": 3000.0
          }
        }
      ]
    },
    {
      "pageDisplayName": "Loot Priority",
      "cursorFillMode": "topToBottom",
      "content": [
        {
          "text": "Value tiers",
          "type": "header"
        },
        {
          "id": "fFirstDibsDelay:General",
          "text": "Gear grace (s)",
          "type": "slider",
          "help": "Anti-snatch grace before a follower takes ordinary gear (or a rejection releases it sooner).",
          "valueOptions": {
            "min": 0.0,
            "max": 60.0,
            "step": 1.0,
            "sourceType": "ModSettingFloat",
            "defaultValue": 4.0
          }
        },
        {
          "text": "Fair chance (Valuables)",
          "type": "header"
        },
        {
          "id": "fChanceRadius:General",
          "text": "Chance radius (units)",
          "type": "slider",
          "help": "How near you must be for looking at a source to count as 'had your chance' at its valuables.",
          "valueOptions": {
            "min": 128.0,
            "max": 2048.0,
            "step": 32.0,
            "sourceType": "ModSettingFloat",
            "defaultValue": 512.0
          }
        },
        {
          "id": "fFairChance:General",
          "text": "Fair-chance time (s)",
          "type": "slider",
          "help": "Seconds you spend near AND facing a source (3x while looting it) before its valuables release.",
          "valueOptions": {
            "min": 0.0,
            "max": 30.0,
            "step": 0.5,
            "sourceType": "ModSettingFloat",
            "defaultValue": 6.0
          }
        },
        {
          "id": "fAbandonDelay:General",
          "text": "Abandon backstop (s)",
          "type": "slider",
          "help": "If you never come near a source, its valuables release after this long (cleanup behind you).",
          "valueOptions": {
            "min": 0.0,
            "max": 120.0,
            "step": 5.0,
            "sourceType": "ModSettingFloat",
            "defaultValue": 45.0
          }
        },
        {
          "text": "Rejection",
          "type": "header"
        },
        {
          "id": "fQuickLootWaiver:General",
          "text": "Rejection linger (s)",
          "type": "slider",
          "help": "After your last take from a source, the follower waits this long before taking the rest.",
          "valueOptions": {
            "min": 0.5,
            "max": 30.0,
            "step": 0.5,
            "sourceType": "ModSettingFloat",
            "defaultValue": 4.0
          }
        },
        {
          "id": "fDepartRadius:General",
          "text": "Depart radius (units)",
          "type": "slider",
          "help": "After you loot a source, walking this far from it counts as moving on (releases it).",
          "valueOptions": {
            "min": 128.0,
            "max": 4096.0,
            "step": 64.0,
            "sourceType": "ModSettingFloat",
            "defaultValue": 700.0
          }
        },
        {
          "text": "Deference",
          "type": "header"
        },
        {
          "id": "fPlayerBubble:General",
          "text": "Yield bubble (units)",
          "type": "slider",
          "help": "A follower never walks to loot within this distance of you -- you win the race for it.",
          "valueOptions": {
            "min": 0.0,
            "max": 1024.0,
            "step": 32.0,
            "sourceType": "ModSettingFloat",
            "defaultValue": 256.0
          }
        }
      ]
    },
    {
      "pageDisplayName": "Behaviour Layer",
      "cursorFillMode": "topToBottom",
      "content": [
        {
          "text": "Invisible strings -- how far a follower ranges from you scales with their confidence to survive alone.",
          "type": "header"
        },
        {
          "id": "bLootTravel:General",
          "text": "Walk to loot (Option A)",
          "type": "toggle",
          "help": "Follower WALKS to loot instead of teleport-grabbing (reworked v0.8.2). On by default; turn off if it misbehaves.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 1
          }
        },
        {
          "id": "iTravelGait:General",
          "text": "Walk-to-loot gait",
          "type": "enum",
          "help": "How fast a follower moves on a loot run. Run is the vanilla-follower default.",
          "valueOptions": {
            "sourceType": "ModSettingInt",
            "options": [
              "Walk",
              "Jog",
              "Run",
              "Fast walk"
            ],
            "defaultValue": 2
          }
        },
        {
          "id": "fTravelRadius:General",
          "text": "Walk-to-loot ceiling (units)",
          "type": "slider",
          "help": "Hard cap on walk distance. The real limit is the confidence leash; raise/lower this only to clamp below it. Default high.",
          "valueOptions": {
            "min": 128.0,
            "max": 8192.0,
            "step": 64.0,
            "sourceType": "ModSettingFloat",
            "defaultValue": 4096.0
          }
        },
        {
          "id": "fBatchLinger:General",
          "text": "Batch: wait for your dibs (s)",
          "type": "slider",
          "help": "On a loot run, if nearby loot is still under YOUR dibs, the follower waits this long (re-scanning) before returning. 0 = never wait.",
          "valueOptions": {
            "min": 0.0,
            "max": 15.0,
            "step": 0.5,
            "sourceType": "ModSettingFloat",
            "defaultValue": 4.0
          }
        },
        {
          "id": "fExcursionMax:General",
          "text": "Batch: max loot-run length (s)",
          "type": "slider",
          "help": "A follower returns to you after a loot run this long, no matter what, so a batch can't run away. The leash still bounds how far he roams.",
          "valueOptions": {
            "min": 5.0,
            "max": 300.0,
            "step": 5.0,
            "sourceType": "ModSettingFloat",
            "defaultValue": 60.0
          }
        },
        {
          "id": "fNavmeshGate:General",
          "text": "Off-navmesh skip (units)",
          "type": "slider",
          "help": "Before walking to loot, MFO checks the nearest navmesh point to the body; farther than this = off the navmesh (can't path) -> skip it before he freezes. ~300. Raise if reachable bodies get skipped; 0 disables.",
          "valueOptions": {
            "min": 0.0,
            "max": 2048.0,
            "step": 25.0,
            "sourceType": "ModSettingFloat",
            "defaultValue": 300.0
          }
        },
        {
          "id": "fLeashMin:General",
          "text": "Leash when cautious (units)",
          "type": "slider",
          "help": "How far from you a follower ranges when they feel UNSAFE (hurt, hard fight). ~512 = about one room.",
          "valueOptions": {
            "min": 128.0,
            "max": 4096.0,
            "step": 64.0,
            "sourceType": "ModSettingFloat",
            "defaultValue": 512.0
          }
        },
        {
          "id": "fLeashMax:General",
          "text": "Leash when confident (units)",
          "type": "slider",
          "help": "How far from you a follower ranges when they feel SAFE (healthy, easy zone). ~4000 = several rooms.",
          "valueOptions": {
            "min": 512.0,
            "max": 8192.0,
            "step": 64.0,
            "sourceType": "ModSettingFloat",
            "defaultValue": 4000.0
          }
        }
      ]
    },
    {
      "pageDisplayName": "Interface",
      "cursorFillMode": "topToBottom",
      "content": [
        {
          "id": "iMenuStyle:General",
          "text": "Board skin",
          "type": "enum",
          "help": "The gambit board's look.",
          "valueOptions": {
            "sourceType": "ModSettingInt",
            "options": [
              "Ebony & Brass",
              "Dwemer Parchment",
              "Soul Cairn",
              "Quicksilver"
            ],
            "defaultValue": 0
          }
        },
        {
          "id": "bShowHud:General",
          "text": "Show combat HUD",
          "type": "toggle",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 0
          }
        },
        {
          "text": "Debug",
          "type": "header"
        },
        {
          "text": "Version",
          "type": "text",
          "help": "MFO version, stamped from the build. Matches the MFO.dll built from the same commit (release.sh stamps it from VERSION).",
          "valueOptions": {
            "value": "v1.0.30"
          }
        },
        {
          "id": "bDebugUnlockSlots:General",
          "text": "Unlock all gambit slots",
          "type": "toggle",
          "help": "DEBUG: open every gambit slot on every follower regardless of rank/rapport, so all gambits are assignable for testing.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 0
          }
        }
      ]
    }
  ]
}