          "text": "Rapport",
          "type": "header"
        },
        {
          "id": "fRapportRate:General",
          "text": "Rapport rate",
          "type": "slider",
          "help": "Multiplier on all rapport earned.",
          "valueOptions": {
            "min": 0.0,
            "max": 5.0,
            "step": 0.05,
            "sourceType": "ModSettingFloat",
            "defaultValue": 1.0
          }
        },
        {
          "id": "fRapportKill:General",
          "text": "Rapport per kill",
          "type": "slider",
          "valueOptions": {
            "min": 0.0,
            "max": 10.0,
            "step": 0.5,
            "sourceType": "ModSettingFloat",
            "defaultValue": 1.0
          }
        },
        {
          "id": "fRapportBossMult:General",
          "text": "Boss multiplier",
          "type": "slider",
          "help": "Rapport multiplier for killing a foe this many levels above you.",
          "valueOptions": {
            "min": 1.0,
            "max": 20.0,
            "step": 0.5,
            "sourceType": "ModSettingFloat",
            "defaultValue": 5.0
          }
        },
        {
          "id": "fRapportDragonMult:General",
          "text": "Dragon multiplier",
          "type": "slider",
          "valueOptions": {
            "min": 1.0,
            "max": 30.0,
            "step": 0.5,
            "sourceType": "ModSettingFloat",
            "defaultValue": 10.0
          }
        },
        {
          "id": "iBossLevelDelta:General",
          "text": "Boss level delta",
          "type": "slider",
          "help": "A foe at least this many levels above you counts as a boss.",
          "valueOptions": {
            "min": 1,
            "max": 30,
            "step": 1,
            "sourceType": "ModSettingInt",
            "defaultValue": 5
          }
        },
        {
          "id": "fSharedRadius:General",
          "text": "Shared-kill radius",
          "type": "slider",
          "help": "A follower within this range shares the kill credit.",
          "valueOptions": {
            "min": 500.0,
            "max": 8000.0,
            "step": 100.0,
            "sourceType": "ModSettingFloat",
            "defaultValue": 3000.0
          }
        },
        {
          "id": "bAllowSummons:General",
          "text": "Count summon kills",
          "type": "toggle",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 0
          }
        }
      ]
    },
    {
      "pageDisplayName": "Combat & Casting",
      "cursorFillMode": "topToBottom",
      "content": [
        {
          "text": "Gambits",
          "type": "header"
        },
        {
          "id": "bEquipToCast:General",
          "text": "Equip spells to cast",
          "type": "toggle",
          "help": "Put a gambit spell in the follower's hand so their own AI casts it.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 1
          }
        },
        {
          "id": "bCasterHook:General",
          "text": "Influence casting (mobile)",
          "type": "toggle",
          "help": "Let a follower cast a gambit spell while still moving and fighting. Installs a hook; needs a game restart.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 1
          }
        },
        {
          "id": "bCommandTarget:General",
          "text": "Commanded targeting",
          "type": "toggle",
          "help": "Let attack gambits pick which foe a follower fights. Needs a game restart.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 1
          }
        },
        {
          "text": "Timing",
          "type": "header"
        },
        {
          "id": "fCastCooldown:General",
          "text": "Cast cooldown (s)",
          "type": "slider",
          "help": "Minimum seconds between a follower's gambit casts.",
          "valueOptions": {
            "min": 0.0,
            "max": 30.0,
            "step": 0.5,
            "sourceType": "ModSettingFloat",
            "defaultValue": 4.0
          }
        },
        {
          "id": "fAiCastGrace:General",
          "text": "AI cast grace (s)",
          "type": "slider",
          "help": "How long to wait for the follower's own AI to cast before MFO does it silently.",
          "valueOptions": {
            "min": 0.0,
            "max": 15.0,
            "step": 0.5,
            "sourceType": "ModSettingFloat",
            "defaultValue": 3.0
          }
        },
        {
          "id": "fMagickaReserve:General",
          "text": "Magicka reserve",
          "type": "slider",
          "help": "Fraction of magicka a gambit will not spend below. 0 = spend freely.",
          "valueOptions": {
            "min": 0.0,
            "max": 0.9,
            "step": 0.05,
            "sourceType": "ModSettingFloat",
            "defaultValue": 0.0
          }
        }
      ]
    },
    {
      "pageDisplayName": "Logistics",
      "cursorFillMode": "topToBottom",
      "content": [
        {
          "text": "Non-combat behaviour",
          "type": "header"
        },
        {
          "id": "bLogistics:General",
          "text": "Enable logistics",
          "type": "toggle",
          "help": "Let followers drink potions and loot arrows/potions/gear out of combat.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": 1
          }
        },
        {
          "id": "fFirstDibsDelay:General",
          "text": "First-dibs delay (s)",
          "type": "slider",
          "help": "How long a follower waits before looting an item, leaving it for you first.",
          "valueOptions": {
            "min": 0.0,
            "max": 120.0,
            "step": 1.0,
            "sourceType": "ModSettingFloat",
            "defaultValue": 4.0
          }
        },
        {
          "id": "fQuickLootWaiver:General",
          "text": "QuickLoot waiver (s)",
          "type": "slider",
          "help": "Once you loot from a source, followers may take the rest after this short delay.",
          "valueOptions": {
            "min": 0.5,
            "max": 30.0,
            "step": 0.5,
            "sourceType": "ModSettingFloat",
            "defaultValue": 4.0
          }
        },
        {
          "id": "fLootRadius:General",
          "text": "Loot scan (units)",
          "type": "slider",
          "help": "How far a follower scans for loot (~70 units = 1m; a cell = 4096; 3000 ~= 4-5 rooms). Candidates must also be within the confidence leash of you.",
          "valueOptions": {
            "min": 200.0,
            "max": 4096.0,
            "step": 50.0,
            "sourceType": "ModSettingFloat",
            "defaultValue": 3000.0
          }
        }
      ]
    },
    {
      "pageDisplayName": "Behaviour Layer",
      "cursorFillMode": "topToBottom",
      "content": [
        {
          "text": "Invisible strings -- how far a follower ranges from you scales with their confidence to survive alone.",
          "type": "header"
        },
        {
          "id": "bLootTravel:General",
          "text": "Walk to loot (Option A)",
          "type": "toggle",
          "help": "Follower WALKS to loot instead of teleport-grabbing. Experimental; off by default while it is field-tested.",
          "valueOptions": {
            "sourceType": "ModSettingBool",
            "defaultValue": false
          }
        },
        {
          "id": "fLeashMin:General",
          "text": "Leash when cautious (units)",
          "type": "slider",
          "help": "How far from you a follower ranges when they feel UNSAFE (hurt, hard fight). ~512 = about one room.",
          "valueOptions": {
            "min": 128.0,
            "max": 4096.0,
            "step": 64.0,
            "sourceType": "ModSettingFloat",
            "defaultValue": 512.0
          }
        },
        {
          "id": "fLeashMax:General",
          "text": "Leash when confident (units)",
          "type": "slider",
          "help": "How far from you a follower ranges when they feel SAFE (healthy, easy zone). ~4000 = several rooms.",
          "valueOptions": {
            "min": 512.0,
            "max": 8192.0,
            "step": 64.0,
            "sourceType": "ModSettingFloat",
            "defaultValue": 4000.0
          }
        }
      ]
    },
    {
