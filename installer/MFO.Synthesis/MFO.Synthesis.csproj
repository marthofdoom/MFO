<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>marth's Follower Overhaul Synthesis Patcher</Product>
    <Company>marth</Company>
    <Description>Synthesis patcher: scans the load order and writes MFO's item catalog (mfo_items.json) — potion restore-type, ammo class, jewelry, and a "never loot" exclusion list — so the follower's gambits categorize items from real record data instead of fragile runtime guesses (Requiem-proof).</Description>
    <InformationalVersion>1.0.3</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned pairing, MUST match the user's Synthesis: Synthesis 0.36.6 (on
         .NET 10) -> Mutagen 0.54.4. When Synthesis bumps its .NET runtime the
         patcher's TargetFramework must follow, or Synthesis builds to the wrong
         bin/Release/<tfm> path and reports "compiled git patcher executable not
         found" (net10.0 expected, net9.0 produced). Bump all three together. -->
    <PackageReference Include="Mutagen.Bethesda.Synthesis" Version="0.36.6" />
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.4" />
  </ItemGroup>

</Project>
