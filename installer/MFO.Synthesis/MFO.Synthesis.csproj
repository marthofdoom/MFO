<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>marth's Follower Overhaul Synthesis Patcher</Product>
    <Company>marth</Company>
    <Description>Synthesis patcher: scans the load order and writes MFO's item catalog (mfo_items.json) — potion restore-type, ammo class, jewelry, and a "never loot" exclusion list — so the follower's gambits categorize items from real record data instead of fragile runtime guesses (Requiem-proof).</Description>
    <InformationalVersion>1.0.2</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same pinned pairing MEO/MAO proved: Synthesis 0.36.5 -> Mutagen 0.54.2. -->
    <PackageReference Include="Mutagen.Bethesda.Synthesis" Version="0.36.5" />
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.2" />
  </ItemGroup>

</Project>
